{
  "ladder": [
    {
      "provider": "openai-codex",
      "model": "gpt-6.1-sol",
      "thinking": "xhigh",
      "label": "gpt-6.1-sol",
      "checkpointAtTokens": 300000
    }
  ],
  "subagents": {
    "quantity": 3,
    "model":     {
      "provider": "runinfra",
      "model": "deepseek-v4-1-flash-1017",
      "thinking": "high",
      "label": "deepseek-v4-1-flash-1017",
      "checkpointAtTokens": 350000
    }
  },
  "singleTier": true,
  "commitOnMatch": true,
  "commitOnPark": true,
  "autoFold": true,
  "maxFunctions": 1000,
  "runtimeDir": "run_output/autoloop",
  "approvalsDir": "notes/human-needed-approvals",
  "integration": {
    "mode": "patch",
    "allowCommits": false,
    "allowedRoots": [
      "src",
      "include",
      "configs",
      "notes",
      "plans",
      ".pi/autoloop.json"
    ]
  },
  "sourcePolicy": {
    "allowEmptyMemoryBarrier": true,
    "allowStackPointerSwitch": true,
    "allowlist": {
      "libcd_1": [
        "flag-override"
      ],
      "libds_5": [
        "flag-override"
      ],
      "libds_9": [
        "flag-override"
      ],
      "libetc_3": [
        "flag-override"
      ],
      "libgpu_2": [
        "flag-override"
      ],
      "libgpu_3": [
        "flag-override"
      ],
      "libgpu_4": [
        "flag-override"
      ],
      "libgs_95": [
        "flag-override"
      ]
    }
  }
}
